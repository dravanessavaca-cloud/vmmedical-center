-- ============================================================
-- VM Medical Center — Migración 001: Esquema inicial
-- Aplicar en: Supabase Dashboard → SQL Editor
-- ============================================================

-- Extensiones
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- ============================================================
-- FUNCIÓN: trigger updated_at automático
-- ============================================================
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ============================================================
-- TABLA: profiles (extiende auth.users)
-- ============================================================
CREATE TABLE IF NOT EXISTS profiles (
  id             UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  email          TEXT NOT NULL,
  full_name      TEXT NOT NULL,
  role           TEXT NOT NULL CHECK (role IN ('admin','recepcionista','medico','podologo')),
  specialty      TEXT,
  license_number TEXT,
  phone          TEXT,
  avatar_url     TEXT,
  is_active      BOOLEAN NOT NULL DEFAULT TRUE,
  created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TRIGGER trg_profiles_updated_at
  BEFORE UPDATE ON profiles
  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ============================================================
-- TABLA: patients
-- ============================================================
CREATE TABLE IF NOT EXISTS patients (
  id                        UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  medical_record_number     TEXT UNIQUE NOT NULL,
  first_name                TEXT NOT NULL,
  last_name                 TEXT NOT NULL,
  id_number                 TEXT NOT NULL UNIQUE,  -- Cédula ecuatoriana
  date_of_birth             DATE NOT NULL,
  gender                    TEXT NOT NULL CHECK (gender IN ('masculino','femenino','otro')),
  blood_type                TEXT CHECK (blood_type IN ('A+','A-','B+','B-','AB+','AB-','O+','O-')),
  phone                     TEXT NOT NULL,
  email                     TEXT,
  address                   TEXT,
  city                      TEXT,
  occupation                TEXT,
  emergency_contact_name    TEXT,
  emergency_contact_phone   TEXT,
  emergency_contact_relation TEXT,
  insurance_company         TEXT,
  insurance_number          TEXT,
  notes                     TEXT,
  is_active                 BOOLEAN NOT NULL DEFAULT TRUE,
  created_by                UUID NOT NULL REFERENCES auth.users(id),
  updated_by                UUID REFERENCES auth.users(id),
  created_at                TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at                TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at                TIMESTAMPTZ
);

-- Secuencia para número de historia clínica
CREATE SEQUENCE IF NOT EXISTS medical_record_seq START 1;

-- Función que genera automáticamente HC-YYYY-NNNN
CREATE OR REPLACE FUNCTION generate_medical_record_number()
RETURNS TRIGGER AS $$
BEGIN
  IF NEW.medical_record_number IS NULL OR NEW.medical_record_number = '' THEN
    NEW.medical_record_number := 'HC-' || TO_CHAR(NOW(), 'YYYY') || '-' || LPAD(NEXTVAL('medical_record_seq')::TEXT, 4, '0');
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_patients_medical_record_number
  BEFORE INSERT ON patients
  FOR EACH ROW EXECUTE FUNCTION generate_medical_record_number();

CREATE TRIGGER trg_patients_updated_at
  BEFORE UPDATE ON patients
  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ============================================================
-- TABLA: appointments
-- ============================================================
CREATE TABLE IF NOT EXISTS appointments (
  id                 UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  patient_id         UUID NOT NULL REFERENCES patients(id),
  professional_id    UUID NOT NULL REFERENCES auth.users(id),
  appointment_date   DATE NOT NULL,
  appointment_time   TIME NOT NULL,
  duration_minutes   INTEGER NOT NULL DEFAULT 30,
  type               TEXT NOT NULL DEFAULT 'consulta_medica' CHECK (type IN ('consulta_medica','consulta_podologica','control','procedimiento','certificado','otro')),
  reason             TEXT NOT NULL,
  status             TEXT NOT NULL DEFAULT 'pendiente' CHECK (status IN ('pendiente','confirmada','atendida','cancelada','no_asistio')),
  notes              TEXT,
  google_event_id    TEXT,
  google_calendar_id TEXT,
  sync_status        TEXT CHECK (sync_status IN ('synced','pending','error','not_configured')),
  last_synced_at     TIMESTAMPTZ,
  cancelled_reason   TEXT,
  created_by         UUID NOT NULL REFERENCES auth.users(id),
  updated_by         UUID REFERENCES auth.users(id),
  created_at         TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at         TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_appointments_date ON appointments(appointment_date);
CREATE INDEX idx_appointments_patient ON appointments(patient_id);
CREATE INDEX idx_appointments_professional ON appointments(professional_id);
CREATE INDEX idx_appointments_status ON appointments(status);

CREATE TRIGGER trg_appointments_updated_at
  BEFORE UPDATE ON appointments
  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ============================================================
-- TABLA: vital_signs
-- ============================================================
CREATE TABLE IF NOT EXISTS vital_signs (
  id                      UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  patient_id              UUID NOT NULL REFERENCES patients(id),
  appointment_id          UUID REFERENCES appointments(id),
  medical_record_id       UUID,
  weight_kg               NUMERIC(5,2),
  height_cm               NUMERIC(5,1),
  bmi                     NUMERIC(5,2),
  temperature_c           NUMERIC(4,1),
  heart_rate_bpm          INTEGER,
  respiratory_rate_rpm    INTEGER,
  oxygen_saturation_pct   INTEGER,
  systolic_bp             INTEGER,
  diastolic_bp            INTEGER,
  blood_glucose_mgdl      NUMERIC(6,2),
  observations            TEXT,
  recorded_by             UUID NOT NULL REFERENCES auth.users(id),
  created_at              TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at              TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_vital_signs_patient ON vital_signs(patient_id);
CREATE INDEX idx_vital_signs_created ON vital_signs(created_at DESC);

CREATE TRIGGER trg_vital_signs_updated_at
  BEFORE UPDATE ON vital_signs
  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ============================================================
-- TABLA: medical_records
-- ============================================================
CREATE TABLE IF NOT EXISTS medical_records (
  id                    UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  patient_id            UUID NOT NULL REFERENCES patients(id),
  appointment_id        UUID REFERENCES appointments(id),
  physician_id          UUID NOT NULL REFERENCES auth.users(id),
  chief_complaint       TEXT NOT NULL,
  current_illness       TEXT NOT NULL,
  personal_history      TEXT,
  surgical_history      TEXT,
  family_history        TEXT,
  allergies             TEXT,
  current_medications   TEXT,
  systems_review        TEXT,
  physical_exam_general TEXT,
  physical_exam_systems TEXT,
  presumptive_diagnosis TEXT,
  definitive_diagnosis  TEXT,
  cie10_code            TEXT,
  cie10_description     TEXT,
  therapeutic_plan      TEXT,
  indications           TEXT,
  observations          TEXT,
  follow_up_date        DATE,
  is_complete           BOOLEAN NOT NULL DEFAULT FALSE,
  created_by            UUID NOT NULL REFERENCES auth.users(id),
  updated_by            UUID REFERENCES auth.users(id),
  created_at            TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at            TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at            TIMESTAMPTZ
);

CREATE INDEX idx_medical_records_patient ON medical_records(patient_id);
CREATE INDEX idx_medical_records_physician ON medical_records(physician_id);

CREATE TRIGGER trg_medical_records_updated_at
  BEFORE UPDATE ON medical_records
  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Fk de vital_signs a medical_records (después de crear la tabla)
ALTER TABLE vital_signs ADD CONSTRAINT fk_vs_medical_record
  FOREIGN KEY (medical_record_id) REFERENCES medical_records(id);

-- ============================================================
-- TABLA: audit_log (inmutable — no UPDATE)
-- ============================================================
CREATE TABLE IF NOT EXISTS audit_log (
  id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id     UUID NOT NULL REFERENCES auth.users(id),
  action      TEXT NOT NULL,
  table_name  TEXT NOT NULL,
  record_id   TEXT NOT NULL,
  old_data    JSONB,
  new_data    JSONB,
  ip_address  INET,
  user_agent  TEXT,
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_audit_log_user ON audit_log(user_id);
CREATE INDEX idx_audit_log_table ON audit_log(table_name);
CREATE INDEX idx_audit_log_created ON audit_log(created_at DESC);

-- ============================================================
-- TABLA: clinic_settings (fila única)
-- ============================================================
CREATE TABLE IF NOT EXISTS clinic_settings (
  id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  clinic_name     TEXT NOT NULL DEFAULT 'VM Medical Center',
  ruc             TEXT,
  address         TEXT,
  city            TEXT DEFAULT 'Quito',
  phone           TEXT,
  whatsapp        TEXT,
  email           TEXT,
  website         TEXT,
  logo_url        TEXT,
  document_footer TEXT,
  updated_by      UUID REFERENCES auth.users(id),
  updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Insertar configuración inicial
INSERT INTO clinic_settings (clinic_name, city, document_footer)
VALUES ('VM Medical Center', 'Quito, Ecuador', 'Centro Médico VM Medical Center · Ecuador')
ON CONFLICT DO NOTHING;

-- ============================================================
-- ROW LEVEL SECURITY (RLS)
-- ============================================================

-- Habilitar RLS en todas las tablas
ALTER TABLE profiles        ENABLE ROW LEVEL SECURITY;
ALTER TABLE patients        ENABLE ROW LEVEL SECURITY;
ALTER TABLE appointments    ENABLE ROW LEVEL SECURITY;
ALTER TABLE vital_signs     ENABLE ROW LEVEL SECURITY;
ALTER TABLE medical_records ENABLE ROW LEVEL SECURITY;
ALTER TABLE audit_log       ENABLE ROW LEVEL SECURITY;
ALTER TABLE clinic_settings ENABLE ROW LEVEL SECURITY;

-- ── Función helper: obtener rol del usuario actual ────────────
CREATE OR REPLACE FUNCTION get_user_role()
RETURNS TEXT AS $$
  SELECT role FROM profiles WHERE id = auth.uid()
$$ LANGUAGE SQL SECURITY DEFINER STABLE;

-- ── profiles ─────────────────────────────────────────────────
CREATE POLICY "profiles_select_own" ON profiles
  FOR SELECT USING (id = auth.uid() OR get_user_role() = 'admin');

CREATE POLICY "profiles_insert_admin" ON profiles
  FOR INSERT WITH CHECK (get_user_role() = 'admin');

CREATE POLICY "profiles_update_own_or_admin" ON profiles
  FOR UPDATE USING (id = auth.uid() OR get_user_role() = 'admin');

-- ── patients ──────────────────────────────────────────────────
-- Todos los roles autenticados pueden leer pacientes activos
CREATE POLICY "patients_select_auth" ON patients
  FOR SELECT USING (auth.uid() IS NOT NULL AND deleted_at IS NULL);

-- Admin y recepcionista crean pacientes
CREATE POLICY "patients_insert" ON patients
  FOR INSERT WITH CHECK (get_user_role() IN ('admin','recepcionista'));

-- Admin y recepcionista editan pacientes
CREATE POLICY "patients_update" ON patients
  FOR UPDATE USING (get_user_role() IN ('admin','recepcionista'));

-- Solo admin puede hacer soft delete
CREATE POLICY "patients_soft_delete" ON patients
  FOR UPDATE USING (get_user_role() = 'admin');

-- ── appointments ──────────────────────────────────────────────
-- Admin y recepcionista ven todas; médico/podólogo ven las suyas
CREATE POLICY "appointments_select" ON appointments
  FOR SELECT USING (
    get_user_role() IN ('admin','recepcionista')
    OR professional_id = auth.uid()
  );

CREATE POLICY "appointments_insert" ON appointments
  FOR INSERT WITH CHECK (get_user_role() IN ('admin','recepcionista'));

CREATE POLICY "appointments_update" ON appointments
  FOR UPDATE USING (
    get_user_role() IN ('admin','recepcionista')
    OR professional_id = auth.uid()
  );

-- ── vital_signs ───────────────────────────────────────────────
CREATE POLICY "vital_signs_select" ON vital_signs
  FOR SELECT USING (auth.uid() IS NOT NULL);

CREATE POLICY "vital_signs_insert" ON vital_signs
  FOR INSERT WITH CHECK (auth.uid() IS NOT NULL);

CREATE POLICY "vital_signs_update" ON vital_signs
  FOR UPDATE USING (get_user_role() IN ('admin','medico','podologo'));

-- ── medical_records ───────────────────────────────────────────
-- Nadie borra historias clínicas (soft delete solo admin)
CREATE POLICY "medical_records_select" ON medical_records
  FOR SELECT USING (
    auth.uid() IS NOT NULL AND deleted_at IS NULL
    AND (get_user_role() IN ('admin','recepcionista') OR physician_id = auth.uid())
  );

CREATE POLICY "medical_records_insert" ON medical_records
  FOR INSERT WITH CHECK (get_user_role() IN ('admin','medico','podologo'));

CREATE POLICY "medical_records_update" ON medical_records
  FOR UPDATE USING (
    get_user_role() = 'admin'
    OR (get_user_role() IN ('medico','podologo') AND physician_id = auth.uid())
  );

-- ── audit_log ─────────────────────────────────────────────────
-- Solo admin lee; todos insertan (registrar sus propias acciones)
CREATE POLICY "audit_log_select_admin" ON audit_log
  FOR SELECT USING (get_user_role() = 'admin');

CREATE POLICY "audit_log_insert_auth" ON audit_log
  FOR INSERT WITH CHECK (auth.uid() IS NOT NULL);

-- Nadie puede actualizar o borrar audit_log
-- (solo INSERT permitido)

-- ── clinic_settings ───────────────────────────────────────────
CREATE POLICY "clinic_settings_select" ON clinic_settings
  FOR SELECT USING (auth.uid() IS NOT NULL);

CREATE POLICY "clinic_settings_update" ON clinic_settings
  FOR UPDATE USING (get_user_role() = 'admin');

-- ============================================================
-- FUNCIÓN: crear perfil automáticamente al registrar usuario
-- ============================================================
CREATE OR REPLACE FUNCTION handle_new_user()
RETURNS TRIGGER AS $$
BEGIN
  INSERT INTO profiles (id, email, full_name, role)
  VALUES (
    NEW.id,
    NEW.email,
    COALESCE(NEW.raw_user_meta_data->>'full_name', split_part(NEW.email, '@', 1)),
    COALESCE(NEW.raw_user_meta_data->>'role', 'recepcionista')
  )
  ON CONFLICT (id) DO NOTHING;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE OR REPLACE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION handle_new_user();
