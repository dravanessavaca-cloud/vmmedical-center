async function main() {
  console.log('\n\x1b[1m🏥 VM Medical Center — Setup de usuarios\x1b[0m')
  sep()

  // ── 1. Verificar que las tablas existen ────────────────────
  log('Verificando tablas en Supabase...')
  const check = await fetch(`${SUPABASE_URL}/rest/v1/profiles?limit=1`, {
    headers: { 'apikey': SUPABASE_SERVICE, 'Authorization': `Bearer ${SUPABASE_SERVICE}` }
  })

  if (check.status === 404 || check.status === 400) {
    const body = await check.text()
    if (body.includes('relation') || body.includes('does not exist') || body.includes('42P01')) {
      err('Las tablas NO existen aún en Supabase.')
      console.log('\n\x1b[33m⚠️  Primero aplica el schema SQL:\x1b[0m')
      console.log('   1. Abre: https://supabase.com/dashboard/project/pjwefetpngpmeaymzdew/sql/new')
      console.log('   2. Pega el contenido de: supabase/migrations/001_initial_schema.sql')
      console.log('   3. Clic en "Run"')
      console.log('   4. Vuelve a ejecutar este script\n')
      process.exit(1)
    }
  }
  ok('Tablas encontradas')
  sep()

  // ── 2. Crear usuarios ──────────────────────────────────────
  log('Creando usuarios...\n')
  const createdIds = {}

  for (const u of USERS) {
    process.stdout.write(`   [${u.role.padEnd(13)}] ${u.email.padEnd(28)} → `)

    const res = await adminFetch('/auth/v1/admin/users', {
      email: u.email,
      password: u.password,
      email_confirm: true,
      user_metadata: { full_name: u.full_name, role: u.role },
    })

    if (res.id) {
      console.log(`\x1b[32mcreado ✓\x1b[0m  (${res.id.slice(0,8)}...)`)
      createdIds[u.role] = res.id
    } else if (res.msg?.includes('already') || res.error?.includes('already') || res.code === 'email_exists') {
      console.log('\x1b[33mya existía — buscando ID...\x1b[0m')
      // Listar usuarios para encontrar el ID
      const list = await fetch(`${SUPABASE_URL}/auth/v1/admin/users?page=1&per_page=50`, {
        headers: { 'apikey': SUPABASE_SERVICE, 'Authorization': `Bearer ${SUPABASE_SERVICE}` }
      }).then(r => r.json())
      const found = (list.users ?? []).find(x => x.email === u.email)
      if (found) {
        createdIds[u.role] = found.id
        console.log(`\x1b[33m   └─ ID encontrado: ${found.id.slice(0,8)}...\x1b[0m`)
      }
    } else {
      console.log(`\x1b[31mERROR: ${JSON.stringify(res)}\x1b[0m`)
    }
  }

  sep()

  // ── 3. Actualizar perfiles ─────────────────────────────────
  log('Configurando perfiles (rol, especialidad, matrícula)...\n')

  for (const u of USERS) {
    const id = createdIds[u.role]
    if (!id) { err(`Sin ID para ${u.role}, saltando`); continue }
    process.stdout.write(`   [${u.role.padEnd(13)}] ${u.full_name.padEnd(28)} → `)

    const { error } = await restFetch('profiles', {
      id,
      email: u.email,
      full_name: u.full_name,
      role: u.role,
      specialty: u.specialty,
      license_number: u.license_number,
      is_active: true,
    })

    if (error) console.log(`\x1b[31mERROR: ${error}\x1b[0m`)
    else console.log('\x1b[32mok ✓\x1b[0m')
  }

  sep()

  // ── 4. Insertar pacientes de prueba ────────────────────────
  const recepId = createdIds['recepcionista'] ?? Object.values(createdIds)[0]
  if (recepId) {
    log('Insertando pacientes de prueba...\n')
    for (const p of PACIENTES) {
      process.stdout.write(`   ${(p.first_name + ' ' + p.last_name).padEnd(28)} → `)
      const { error } = await restFetch('patients', { ...p, created_by: recepId, is_active: true })
      if (error) {
        if (error.includes('duplicate') || error.includes('23505')) console.log('\x1b[33mya existe\x1b[0m')
        else console.log(`\x1b[31mERROR: ${error}\x1b[0m`)
      } else {
        console.log('\x1b[32mcreado ✓\x1b[0m')
      }
    }
    sep()
  }

  // ── 5. Resumen ─────────────────────────────────────────────
  console.log('\n\x1b[1m\x1b[32m🎉 ¡Todo listo!\x1b[0m\n')
  console.log('\x1b[1mUsuarios del sistema:\x1b[0m')
  console.log('┌──────────────────┬──────────────────────────┬──────────────┐')
  console.log('│ Rol              │ Email                    │ Contraseña   │')
  console.log('├──────────────────┼──────────────────────────┼──────────────┤')
  for (const u of USERS) {
    console.log(`│ ${u.role.padEnd(16)} │ ${u.email.padEnd(24)} │ ${u.password.padEnd(12)} │`)
  }
  console.log('└──────────────────┴──────────────────────────┴──────────────┘')
  console.log('\n\x1b[1mPara correr el sistema:\x1b[0m')
  console.log('  npm run dev')
  console.log('  Abre → http://localhost:5173\n')
}

